# No configuration is needed for the existing local SQLite demo on port 3000.
# Production/Google-account mode uses Supabase. Both values must be configured.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# CONNECTUS_SITE_URL=http://127.0.0.1:3000
# On Vercel, CONNECTUS_SITE_URL must be the exact HTTPS site origin.

# Optional override for the local-only demo. Never use SQLite files on Vercel.
# DATABASE_URL=file:data/connectus.db

# Google client ID and secret belong in Supabase's Google provider settings.
# No Google client secret or Supabase secret/service-role key is needed by this app.
# See docs/supabase-setup.md for local Supabase and Google OAuth configuration.
